$owner = @{}; Get-Process | ForEach-Object { $owner[[int]$_.Id] = $_.ProcessName }
[ordered]@{
  os = $os.Caption + ' (build ' + $os.BuildNumber + ')'
  computerName = $env:COMPUTERNAME
  uptimeSeconds = [int]((Get-Date) - $os.LastBootUpTime).TotalSeconds
  loggedOnUser = (Get-CimInstance Win32_ComputerSystem).UserName
  cpuLoadPercent = [int](Get-CimInstance Win32_Processor | Measure-Object LoadPercentage -Average).Average
  memoryMB = [ordered]@{ total = [int]($os.TotalVisibleMemorySize / 1KB); free = [int]($os.FreePhysicalMemory / 1KB) }
  diskGB = [ordered]@{ total = [math]::Round(($disk.Used + $disk.Free) / 1GB, 1); free = [math]::Round($disk.Free / 1GB, 1) }
  display = '' + $video.CurrentHorizontalResolution + 'x' + $video.CurrentVerticalResolution + '@' + $video.CurrentRefreshRate + ' ' + $video.Name
  topProcesses = @(Get-Process | Sort-Object WorkingSet64 -Descending | Select-Object -First 12 | ForEach-Object {
    [ordered]@{ name = $_.ProcessName; pid = $_.Id; memoryMB = [int]($_.WorkingSet64 / 1MB); cpuSeconds = [int]$_.CPU } })
  listeningPorts = @(Get-NetTCPConnection -State Listen | Where-Object { $_.LocalPort -lt 49152 } | Sort-Object LocalPort, LocalAddress -Unique | ForEach-Object {
    '' + $_.LocalAddress + ':' + $_.LocalPort + ' ' + $owner[[int]$_.OwningProcess] })
  stoppedAutomaticServices = @(Get-Service | Where-Object { $_.StartType -eq 'Automatic' -and $_.Status -ne 'Running' } | ForEach-Object { $_.Name })
  recentErrors = @(Get-WinEvent -FilterHashtable @{ LogName = 'Application', 'System'; Level = 1, 2; StartTime = (Get-Date).AddHours(-1) } -MaxEvents 15 -ErrorAction SilentlyContinue |
    ForEach-Object { $_.TimeCreated.ToString('HH:mm:ss') + ' ' + $_.ProviderName + ' ' + $_.Id + ': ' + (('' + $_.Message) -split "`n")[0].Trim() })
} | ConvertTo-Json -Depth 4
'''


def cmd_diag(a):
    """The guest's health as JSON: load, memory, disk, display, biggest processes, listening ports, stopped services, the last hour's errors."""
    need_running(); p = powershell(DIAGNOSTICS, timeout=90)
    if p.returncode: die('could not read the diagnostics: ' + (p.stderr or p.stdout).decode(errors='replace').strip())
    sys.stdout.write(p.stdout.decode(errors='replace'))


def cmd_copy(a):
    need_running(); c = config()
    remote = lambda path: f"{c['user']}@127.0.0.1:{path.replace(chr(92), '/')}"       # scp wants C:/dir, not C:\\dir
    paths = [remote(p) for p in a.paths[:-1]] + [a.paths[-1]] if a.from_vm else a.paths[:-1] + [remote(a.paths[-1])]
    scp = ['scp', '-q', '-r', '-i', str(HOME / 'id_ed25519'), '-o', 'IdentitiesOnly=yes', '-P', str(c['ssh_port']),
           '-o', 'StrictHostKeyChecking=no', '-o', f'UserKnownHostsFile={HOME / "known_hosts"}', '-o', 'LogLevel=ERROR']
    sys.exit(subprocess.run(scp + paths).returncode)


def cmd_media(a):
    """Attach an ISO to the running VM as a USB disc (until the VM stops); prints its drive letter."""
    need_running(); iso = Path(a.iso).resolve()
    if not iso.is_file(): die(f'{iso} is not a file')
    name = 'media' + str(abs(hash(str(iso))) % 100000)
    qmp('human-monitor-command', {'command-line': f'drive_add 0 file={iso},if=none,id={name},media=cdrom,readonly=on,format=raw'})
    try: qmp('device_add', {'driver': 'usb-storage', 'drive': name, 'id': name + 'dev'})
    except RuntimeError as e:
        if 'Duplicate' not in str(e) and 'already' not in str(e): raise
    time.sleep(6)
    p = powershell("(Get-Volume | Where-Object { $_.DriveType -eq 'CD-ROM' -and $_.Size -gt 0 } | Sort-Object DriveLetter | Select-Object -Last 1).DriveLetter", timeout=60)
    print(p.stdout.decode().strip())


def launch(command_line):
    """Start a program on the logged-in desktop: SSH itself lands in a session without one."""
    name = f'winvm-{os.getpid()}-{int(time.time())}'
    payload = base64.b64encode((command_line + '\r\n').encode()).decode()
    return powershell(
        "Get-ChildItem C:\\winvm\\winvm-*.cmd | Where-Object LastWriteTime -lt (Get-Date).AddDays(-1) | Remove-Item; "   # earlier launches' scripts
        f"[IO.File]::WriteAllBytes('C:\\winvm\\{name}.cmd',[Convert]::FromBase64String('{payload}')); "
        f"schtasks /create /tn {name} /tr 'conhost.exe --headless C:\\winvm\\{name}.cmd' /sc once /st 23:59 /it /ru {config()['user']} /rl limited /f | Out-Null; "
        f"schtasks /run /tn {name} | Out-Null; schtasks /delete /tn {name} /f | Out-Null", timeout=60)


def cmd_launch(a):
    need_running(); p = launch(' '.join(a.command))
    if p.returncode: die('could not start it: ' + (p.stderr or p.stdout).decode(errors='replace').strip())


def screenshot(path):
    qmp('screendump', {'filename': str(path), 'format': 'png'}, timeout=20)
    with open(path, 'rb') as f: head = f.read(24)
    return struct.unpack('>II', head[16:24])


def cmd_screenshot(a):
    if not running(): die('the VM is not running (winvm up)', 3)
    out = Path(a.out).resolve(); width, height = screenshot(out)
    print(json.dumps({'path': str(out), 'width': width, 'height': height}) if a.json else f'{out} {width}x{height}')


KEYS = {'enter': 'ret', 'return': 'ret', 'escape': 'esc', 'space': 'spc', 'del': 'delete', 'win': 'meta_l', 'windows': 'meta_l', 'meta': 'meta_l', 'super': 'meta_l', 'pageup': 'pgup',
        'pagedown': 'pgdn', 'control': 'ctrl', 'ins': 'insert'}
SYMBOLS = {' ': 'spc', '-': 'minus', '=': 'equal', '[': 'bracket_left', ']': 'bracket_right', '\\': 'backslash', ';': 'semicolon', "'": 'apostrophe',
           '`': 'grave_accent', ',': 'comma', '.': 'dot', '/': 'slash', '\n': 'ret', '\t': 'tab'}
SHIFTED = dict(zip('!@#$%^&*()_+{}|:"~<>?', '1234567890-=[]\\;\'`,./'))


def key_events(names):
    codes = [KEYS.get(n.lower(), n.lower()) for n in names]
    def ev(code, down): return {'type': 'key', 'data': {'down': down, 'key': {'type': 'qcode', 'data': code}}}
    return [ev(c, True) for c in codes] + [ev(c, False) for c in reversed(codes)]


def cmd_input(a):
    if not running(): die('the VM is not running (winvm up)', 3)
    if a.action == 'key':
        for combo in a.args: qmp('input-send-event', {'events': key_events(combo.split('+'))}); time.sleep(0.03)
    elif a.action == 'type':
        for ch in ' '.join(a.args):
            shift = ch.isupper() or ch in SHIFTED
            base = SHIFTED.get(ch, ch).lower()
            code = SYMBOLS.get(base, base)
            if not (code.isalnum() or code in SYMBOLS.values()): die(f'cannot type {ch!r} (US keyboard characters only)')
            if shift: qmp('input-send-event', {'events': key_events(['shift'])[:1]}); time.sleep(0.02)   # a held shift, not a chord
            qmp('input-send-event', {'events': key_events([code])}); time.sleep(0.02)
            if shift: qmp('input-send-event', {'events': key_events(['shift'])[1:]}); time.sleep(0.01)
    else:                                   # move / click / doubleclick / rightclick  X Y
        if len(a.args) != 2: die(f'{a.action} takes X Y in screen pixels')
        x, y = (int(v) for v in a.args); width, height = screenshot(RUN / 'input-probe.png')
        if not (0 <= x < width and 0 <= y < height): die(f'{x},{y} is outside the {width}x{height} screen')
        qmp('input-send-event', {'events': [{'type': 'abs', 'data': {'axis': 'x', 'value': x * 32767 // (width - 1)}},
                                            {'type': 'abs', 'data': {'axis': 'y', 'value': y * 32767 // (height - 1)}}]})
        button = 'right' if a.action == 'rightclick' else 'left'
        for _ in range({'move': 0, 'doubleclick': 2}.get(a.action, 1)):
            time.sleep(0.05)
            for down in (True, False):
                qmp('input-send-event', {'events': [{'type': 'btn', 'data': {'down': down, 'button': button}}]}); time.sleep(0.03)


def open_viewer():
    if pid_of('viewer') is None and running(): spawn('viewer', [sys.executable, str(HERE / 'viewer.py')], 'viewer.log')


def cmd_view(a):
    if not running(): die('the VM is not running (winvm up)', 3)
    open_viewer()


def cmd_snapshot(a):
    disk = str(HOME / 'img/win.qcow2')
    if a.action == 'list': sys.exit(subprocess.run(['qemu-img', 'snapshot', '-l', disk]).returncode)
    if running(): die('stop the VM first (winvm down): snapshots are taken of the disk at rest')
    flag = {'save': '-c', 'restore': '-a', 'delete': '-d'}[a.action]
    if a.action == 'save': subprocess.run(['qemu-img', 'snapshot', '-d', a.name, disk], capture_output=True)   # replace
    sys.exit(subprocess.run(['qemu-img', 'snapshot', flag, a.name, disk]).returncode)


# ---- building a VM --------------------------------------------------------------------------------------------------
MEDIA = {   # what `create` downloads when it is not in media/ yet
    'win11.iso': 'https://go.microsoft.com/fwlink/?linkid=2289031&clcid=0x409&culture=en-us&country=us',   # Windows 11 Enterprise, 90-day evaluation
    'virtio-win.iso': 'https://fedorapeople.org/groups/virtio-win/direct-downloads/stable-virtio/virtio-win.iso',
    'OpenSSH-Win64.msi': 'https://github.com/PowerShell/Win32-OpenSSH/releases/download/v9.8.3.0p2-Preview/OpenSSH-Win64-v9.8.3.0.msi',
}


def cmd_create(a):
    """Install Windows unattended into a new VM in WINVM_HOME: about 15 minutes after the downloads."""
    disk = HOME / 'img/win.qcow2'
    if disk.exists(): die(f'{disk} exists: this would replace the VM. Move it away first.')
    if running(): die('a VM is running from this folder (winvm down)')
    if not shutil.which('7z'): die('7z is needed to unpack drivers from the virtio ISO')
    for d in ('img', 'media'): (HOME / d).mkdir(parents=True, exist_ok=True)
    subprocess.run(['chattr', '+C', str(HOME / 'img')], capture_output=True)       # btrfs: no copy-on-write under a disk image
    for name, url in MEDIA.items():
        target = HOME / 'media' / name
        if not target.exists():
            print(f'downloading {name} …', flush=True)
            subprocess.run(['curl', '-L', '--fail', '-sS', '-C', '-', '-o', str(target) + '.part', url], check=True)
            (HOME / 'media' / (name + '.part')).rename(target)
    key = HOME / 'id_ed25519'
    if not key.exists(): subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'winvm', '-f', str(key)], check=True)
    secret = HOME / 'password'
    if not secret.exists():
        import secrets
        secret.touch(mode=0o600); secret.write_text('Wv' + secrets.token_hex(8) + '!a\n')
    # The answer file and what setup.ps1 installs go on a USB stick that Windows Setup searches.
    stick = HOME / 'unattend'
    shutil.rmtree(stick, ignore_errors=True); (stick / 'winvm').mkdir(parents=True)
    (stick / 'autounattend.xml').write_text((HERE / 'guest/autounattend.xml').read_text().replace('@PASSWORD@', secret.read_text().strip()))
    (stick / 'autounattend.xml').chmod(0o600)
    for name in ('setup.ps1', 'clipwatch.ps1'): shutil.copy(HERE / 'guest' / name, stick / 'winvm')
    shutil.copy(str(key) + '.pub', stick / 'winvm/authorized_keys')
    shutil.copy(HOME / 'media/OpenSSH-Win64.msi', stick / 'winvm')
    iso = str(HOME / 'media/virtio-win.iso')
    subprocess.run(['7z', 'x', '-y', f'-o{stick / "winvm"}', iso, 'virtio-win-guest-tools.exe'], check=True, capture_output=True)
    subprocess.run(['7z', 'e', '-y', f'-o{stick / "winvm"}', iso, 'viogpudo/w11/amd64/vgpusrv.exe', 'viogpudo/w11/amd64/viogpuap.exe'], check=True, capture_output=True)
    for driver in ('viostor', 'NetKVM', 'vioserial', 'Balloon'):          # not the display driver: it blanks Setup's screen
        subprocess.run(['7z', 'x', '-y', f'-o{stick / "$WinPEDriver$"}', iso, f'{driver}/w11/amd64/*'], check=True, capture_output=True)
    subprocess.run(['qemu-img', 'create', '-q', '-f', 'qcow2', str(disk), a.size], check=True)
    shutil.copy('/usr/share/edk2/ovmf/OVMF_VARS_4M.qcow2', HOME / 'img/OVMF_VARS.qcow2')
    shutil.rmtree(HOME / 'tpm', ignore_errors=True)
    print('installing Windows …', flush=True)
    start_vm(['-drive', f"file={HOME / 'media/win11.iso'},if=none,id=cd0,media=cdrom,readonly=on", '-device', 'ide-cd,drive=cd0,bootindex=2',
              '-drive', f'file=fat:ro:{stick},if=none,id=ua,format=raw,readonly=on', '-device', 'usb-storage,drive=ua,removable=on'])
    for _ in range(16):                                                   # "Press any key to boot from CD or DVD"
        qmp('send-key', {'keys': [{'type': 'qcode', 'data': 'spc'}]}); time.sleep(0.5)
    deadline = time.time() + 45 * 60
    while time.time() < deadline:
        if not running(): die('the VM stopped during the install; see ' + str(RUN / 'qemu.log'))
        if ssh_ready() and b'True' in powershell('Test-Path C:\\winvm-setup.done', timeout=30).stdout: break
        time.sleep(10)
    else: die('Windows Setup did not finish in 45 minutes (winvm screenshot shows where it is)')
    built = HOME / 'driver/out'
    if (built / 'viogpudo.sys').exists():                                 # the VSync display driver (driver/rebuild.sh builds it)
        print('installing the display driver …', flush=True)
        powershell('New-Item -Force -ItemType Directory C:\\winvm\\viogpudo-vsync | Out-Null', timeout=30)
        subprocess.run([sys.executable, str(Path(__file__).resolve()), 'copy', *(str(f) for f in built.iterdir()), 'C:\\winvm\\viogpudo-vsync'], check=True)
        install = 'powershell -NoProfile -ExecutionPolicy Bypass -File C:\\winvm\\viogpudo-vsync\\install.ps1'
        powershell(install, timeout=120)                                  # turns test signing on
        powershell('shutdown /r /f /t 0', timeout=30); time.sleep(20)
        if not wait_ssh(600): die('Windows did not come back after enabling test signing')
        time.sleep(20)
        print(powershell(install, timeout=300).stdout.decode(errors='replace').strip())
    else:
        print('no built display driver in driver/out: the stock driver stays (about 40 fps). See docs/windows-vm.md.')
    cmd_down(argparse.Namespace(wait=900))                                # the first shutdown finishes the install: it can take 10 minutes
    shutil.rmtree(stick, ignore_errors=True)
    subprocess.run(['qemu-img', 'snapshot', '-c', 'fresh', str(disk)], check=True)
    print(f'The VM is ready in {HOME} (snapshot "fresh"). Start it with: winvm up --view')


def main():
    ports = lambda v: [int(p) for p in v.replace(',', ' ').split()]
    ap = argparse.ArgumentParser(prog='winvm', description=__doc__.split('\n\n')[0])
    sub = ap.add_subparsers(dest='cmd', required=True)
    def add(name, fn, help): p = sub.add_parser(name, help=help); p.set_defaults(fn=fn); return p
    p = add('up', cmd_up, 'start the VM (if needed), wait for Windows, connect the ports')
    p.add_argument('--to-vm', type=ports, default=[], help="ports on this machine the VM reaches on its localhost, e.g. 3000,3001")
    p.add_argument('--from-vm', type=ports, default=[], help='VM ports this machine reaches on its localhost')
    p.add_argument('--view', action='store_true', help='open the viewer window'); p.add_argument('--wait', type=int, default=600); p.add_argument('--json', action='store_true')
    p = add('ports', cmd_ports, 'replace the connected ports of the running VM')
    p.add_argument('--to-vm', type=ports, default=[]); p.add_argument('--from-vm', type=ports, default=[]); p.add_argument('--json', action='store_true')
    p = add('down', cmd_down, 'shut Windows down and stop the VM'); p.add_argument('--wait', type=int, default=300)
    p = add('status', cmd_status, 'stopped, starting or running; connected ports'); p.add_argument('--json', action='store_true')
    p = add('exec', cmd_exec, 'run a PowerShell command in the VM as its administrator (no desktop)')
    p.add_argument('--cwd'); p.add_argument('--timeout', type=int, default=120); p.add_argument('command', nargs='+')
    add('diag', cmd_diag, "the guest's health as JSON: load, memory, disk, processes, listening ports, recent errors")
    p = add('copy', cmd_copy, 'copy files or folders into the VM (or out of it with --from-vm): winvm copy SRC... DEST')
    p.add_argument('--from-vm', action='store_true'); p.add_argument('paths', nargs='+', metavar='PATH')
    p = add('media', cmd_media, 'attach an ISO to the running VM as a disc; prints its drive letter'); p.add_argument('iso')
    p = add('launch', cmd_launch, "start a program on the VM's desktop"); p.add_argument('command', nargs='+')
    p = add('screenshot', cmd_screenshot, 'save the screen as a PNG'); p.add_argument('out'); p.add_argument('--json', action='store_true')
    p = add('input', cmd_input, 'pointer and keyboard: click X Y | doubleclick X Y | rightclick X Y | move X Y | type TEXT | key ctrl+c ...')
    p.add_argument('action', choices=['click', 'doubleclick', 'rightclick', 'move', 'type', 'key']); p.add_argument('args', nargs='+')
    add('view', cmd_view, 'open the viewer window')
    p = add('snapshot', cmd_snapshot, 'disk snapshots: list | save NAME | restore NAME | delete NAME')
    p.add_argument('action', choices=['list', 'save', 'restore', 'delete']); p.add_argument('name', nargs='?', default='')
    p = add('create', cmd_create, 'install Windows into a new VM (unattended, about 15 minutes after downloads)'); p.add_argument('--size', default='96G')
    sub.add_parser('_tunnel').set_defaults(fn=lambda a: tunnel_loop())
    sub.add_parser('_check').set_defaults(fn=lambda a: check())
    a = ap.parse_args()
    if a.cmd == 'snapshot' and a.action != 'list' and not a.name: ap.error('snapshot needs a name')
    if a.cmd == 'copy' and len(a.paths) < 2: ap.error('copy needs a source and a destination')
    for tool in ('qemu-system-x86_64', 'ssh', 'passt', 'swtpm'):
        if not shutil.which(tool): die(f'{tool} is not installed')
    try: a.fn(a)
    except (OSError, RuntimeError) as e: die(str(e))


if __name__ == '__main__':
    main()
