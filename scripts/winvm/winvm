#!/usr/bin/env python3
"""winvm — the Windows development VM behind Zeron's "Windows VM" project setting (docs/windows-vm.md).

One QEMU/KVM guest, run as an ordinary user process. The VM lives in $WINVM_HOME (default
~/.local/share/winvm): disk image, install media, SSH key, settings (config.json). Nothing here needs root.

The guest never sees this machine's localhost. Ports cross only through `--to-vm` (a port on this machine
that the guest reaches on its own localhost) and `--from-vm` (a guest port this machine reaches on its
localhost), carried by one SSH connection.
"""
import argparse, base64, json, os, re, shutil, signal, socket, struct, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOME = Path(os.environ.get('WINVM_HOME') or Path.home() / '.local/share/winvm')
RUN = Path(os.environ.get('XDG_RUNTIME_DIR') or '/tmp') / ('winvm' if 'WINVM_HOME' not in os.environ else 'winvm-' + HOME.name)
DEFAULTS = {
    'vcpus': max(2, min(8, (os.cpu_count() or 4) - 2)),  # even numbers pair up as hyperthreads
    'pin': '',            # host CPUs for the VM, as taskset takes them ("0-11"); empty = anywhere
    'memory': '8G',
    'ssh_port': 2222,     # this machine's 127.0.0.1 port for the guest's SSH server
    'clip_port': 8766,    # the viewer's port for text copied in the guest
    'user': 'dev',
}


def die(message, code=1):
    print(f'winvm: {message}', file=sys.stderr)
    sys.exit(code)


def config():
    try: saved = json.loads((HOME / 'config.json').read_text())
    except FileNotFoundError: saved = {}
    return {**DEFAULTS, **saved}


# ---- processes ------------------------------------------------------------------------------------------------------
def pid_of(name):
    """The live process recorded in RUN/<name>.pid, or None."""
    try:
        pid = int((RUN / f'{name}.pid').read_text().split()[0]); os.kill(pid, 0); return pid
    except (FileNotFoundError, ValueError, IndexError, ProcessLookupError, PermissionError):
        return None


def stop(name, sig=signal.SIGTERM, group=False):
    pid = pid_of(name)
    if pid:
        try: (os.killpg if group else os.kill)(pid, sig)
        except ProcessLookupError: pass
    (RUN / f'{name}.pid').unlink(missing_ok=True)


def spawn(name, args, log, env=None):
    """Start a detached process that outlives this command; its output goes to RUN/<log>."""
    with open(RUN / log, 'ab') as out:
        p = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=out, stderr=out, start_new_session=True, env=env)
    (RUN / f'{name}.pid').write_text(str(p.pid))
    return p


# ---- QEMU monitor ---------------------------------------------------------------------------------------------------
def qmp(command, arguments=None, timeout=10):
    s = socket.socket(socket.AF_UNIX); s.settimeout(timeout); s.connect(str(RUN / 'qmp.sock')); f = s.makefile('rw')
    f.readline()
    def call(c, a=None):
        f.write(json.dumps({'execute': c, **({'arguments': a} if a else {})}) + '\n'); f.flush()
        while True:
            r = json.loads(f.readline())
            if 'return' in r or 'error' in r: return r
    call('qmp_capabilities')
    r = call(command, arguments)
    if 'error' in r: raise RuntimeError(r['error'].get('desc', str(r['error'])))
    return r['return']


def running():
    return pid_of('qemu') is not None


# ---- SSH ------------------------------------------------------------------------------------------------------------
def ssh_args(*extra):
    c = config()
    return ['ssh', '-q', '-i', str(HOME / 'id_ed25519'), '-o', 'IdentitiesOnly=yes', '-p', str(c['ssh_port']),
            '-o', 'StrictHostKeyChecking=no', '-o', f'UserKnownHostsFile={HOME / "known_hosts"}', '-o', 'LogLevel=ERROR',
            '-o', 'ConnectTimeout=5', *extra, f"{c['user']}@127.0.0.1"]


def ssh_ready(timeout=2.0):
    """The guest's SSH server answers (its banner arrives through the forwarded port)."""
    try:
        with socket.create_connection(('127.0.0.1', config()['ssh_port']), timeout=timeout) as s:
            s.settimeout(timeout); return s.recv(8).startswith(b'SSH-')
    except OSError:
        return False


def powershell(script, timeout=120, cwd=None, capture=True):
    """Run PowerShell in the guest as its administrator (no desktop: use `launch` for windows). Returns the process."""
    body = "$ProgressPreference='SilentlyContinue'; "
    if cwd: body += f"Set-Location -LiteralPath '{cwd.replace(chr(39), chr(39) * 2)}'; "
    # Errors go to stderr as plain text (PowerShell would wrap them in CLIXML); a thrown error fails the command.
    body += (f"try {{ & {{ {script} }} 2>&1 | ForEach-Object {{ if ($_ -is [System.Management.Automation.ErrorRecord]) "
             "{ [Console]::Error.WriteLine(\"$_\") } else { $_ } } | Out-String -Stream -Width 4096 } catch { [Console]::Error.WriteLine(\"$_\"); exit 1 }; exit $LASTEXITCODE")
    encoded = base64.b64encode(body.encode('utf-16-le')).decode()
    # The guest's login shell is PowerShell too; without the explicit exit it would flatten every failure to 1.
    return subprocess.run(ssh_args('-n') + [f'powershell -NoProfile -NonInteractive -EncodedCommand {encoded}; exit $LASTEXITCODE'],
                          capture_output=capture, timeout=timeout)


def need_running():
    if not running(): die('the VM is not running (winvm up)', 3)
    if not ssh_ready(5): die('the VM is still starting: Windows is not answering yet', 4)


# ---- start / stop ---------------------------------------------------------------------------------------------------
def dbus_display_module():
    """Where QEMU finds its D-Bus display when the system package lacks it (None when it has one).

    The viewer and the frame check attach through that display. Fedora ships it as the separate qemu-ui-dbus
    package; without root it is unpacked beside the VMs instead of installed."""
    listed = subprocess.run(['qemu-system-x86_64', '-display', 'help'], capture_output=True, text=True).stdout
    if 'dbus' in listed.split(): return None
    cache = Path.home() / '.local/share/winvm-qemu-modules'
    found = next(cache.rglob('ui-dbus.so'), None) if cache.exists() else None
    if not found and shutil.which('dnf') and shutil.which('rpm2cpio'):
        cache.mkdir(parents=True, exist_ok=True)
        print('fetching QEMU\'s D-Bus display module (qemu-ui-dbus) …', file=sys.stderr, flush=True)
        try: subprocess.run(['dnf', 'download', '-q', 'qemu-ui-dbus'], cwd=cache, capture_output=True, timeout=180)
        except subprocess.TimeoutExpired: pass
        for rpm in cache.glob('qemu-ui-dbus-*.rpm'):
            subprocess.run(f'rpm2cpio {rpm.name} | cpio -idm --quiet', shell=True, cwd=cache, capture_output=True); rpm.unlink()
        found = next(cache.rglob('ui-dbus.so'), None)
    if not found: die('this QEMU has no D-Bus display: install the qemu-ui-dbus package')
    return found.parent


def start_vm(extra=()):
    c = config(); disk = HOME / 'img/win.qcow2'
    if not disk.exists(): die(f'no VM in {HOME} (winvm create)')
    RUN.mkdir(parents=True, exist_ok=True)
    for helper in ('passt', 'swtpm'): stop(helper)
    time.sleep(0.5)                       # an old swtpm still exiting would remove the new socket
    for stale in ('qmp.sock', 'qga.sock', 'swtpm.sock', 'passt.sock'): (RUN / stale).unlink(missing_ok=True)
    (HOME / 'tpm').mkdir(exist_ok=True)
    subprocess.run(['swtpm', 'socket', '--tpm2', '--tpmstate', f'dir={HOME / "tpm"}', '--ctrl', f'type=unixio,path={RUN / "swtpm.sock"}',
                    '--pid', f'file={RUN / "swtpm.pid"}', '--daemon'], check=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # No --map-host-loopback: the guest reaches the internet, never this machine's localhost.
    with open(RUN / 'passt.log', 'ab') as log:
        net = subprocess.run(['passt', '--socket', str(RUN / 'passt.sock'), '--pid', str(RUN / 'passt.pid'), '-a', '192.168.122.50', '-n', '24',
                              '-g', '192.168.122.1', '--map-host-loopback', 'none', '--dns-forward', '192.168.122.2',
                              '-t', f"127.0.0.1/{c['ssh_port']}:22", '-u', 'none', '-q'], stdin=subprocess.DEVNULL, stdout=log, stderr=log)
    if net.returncode:
        stop('swtpm')
        die(f"the VM's network did not start (is port {c['ssh_port']} taken? \"ssh_port\" in {HOME / 'config.json'}); see {RUN / 'passt.log'}")
    env = dict(os.environ)
    module = dbus_display_module()
    if module: env['QEMU_MODULE_DIR'] = str(module)
    vcpus = max(2, int(c['vcpus']) // 2 * 2)
    qemu = ['qemu-system-x86_64', '-name', 'winvm,debug-threads=on', '-machine', 'q35,accel=kvm,hpet=off,vmport=off,memory-backend=mem',
            '-cpu', 'host,hv-passthrough=on,vmx=off', '-smp', f'{vcpus},sockets=1,cores={vcpus // 2},threads=2',
            '-m', c['memory'], '-object', f"memory-backend-memfd,id=mem,size={c['memory']},share=on",
            '-drive', 'if=pflash,format=qcow2,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE_4M.qcow2',
            '-drive', f"if=pflash,format=qcow2,file={HOME / 'img/OVMF_VARS.qcow2'}",
            '-object', 'iothread,id=io0',
            '-drive', f'file={disk},if=none,id=d0,format=qcow2,cache=none,aio=io_uring,discard=unmap,detect-zeroes=unmap',
            '-device', 'virtio-blk-pci,drive=d0,iothread=io0,bootindex=1',
            '-device', 'qemu-xhci', '-device', 'usb-tablet',
            '-netdev', f"stream,id=n0,server=off,addr.type=unix,addr.path={RUN / 'passt.sock'}", '-device', 'virtio-net-pci,netdev=n0,mac=52:54:00:4d:55:01',
            '-device', 'virtio-vga,xres=1920,yres=1080',
            '-audiodev', 'none,id=a0', '-device', 'ich9-intel-hda', '-device', 'hda-output,audiodev=a0',
            '-chardev', f"socket,id=tpm,path={RUN / 'swtpm.sock'}", '-tpmdev', 'emulator,id=tpm0,chardev=tpm', '-device', 'tpm-crb,tpmdev=tpm0',
            '-device', 'virtio-serial-pci', '-chardev', f"socket,id=qga,path={RUN / 'qga.sock'},server=on,wait=off",
            '-device', 'virtserialport,chardev=qga,name=org.qemu.guest_agent.0',
            '-chardev', 'qemu-vdagent,id=vdagent,clipboard=on,mouse=off', '-device', 'virtserialport,chardev=vdagent,name=com.redhat.spice.0',
            '-device', 'virtio-balloon-pci,free-page-reporting=on',
            '-rtc', 'base=localtime,driftfix=slew', '-global', 'kvm-pit.lost_tick_policy=delay',
            '-qmp', f"unix:{RUN / 'qmp.sock'},server=on,wait=off", '-display', 'dbus,p2p=yes', *extra]
    if c['pin']: qemu = ['taskset', '-c', str(c['pin'])] + qemu
    process = spawn('qemu', qemu, 'qemu.log', env)
    for _ in range(100):
        if (RUN / 'qmp.sock').exists() or process.poll() is not None: break
        time.sleep(0.1)
    time.sleep(1)
    if process.poll() is not None:          # (a finished child still answers signals until it is reaped)
        (RUN / 'qemu.pid').unlink(missing_ok=True)
        tail = (RUN / 'qemu.log').read_text(errors='replace').strip().splitlines()[-3:]
        die('QEMU did not stay up:\n  ' + '\n  '.join(tail))


def wait_ssh(seconds):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if not running(): die('the VM stopped while starting; see ' + str(RUN / 'qemu.log'))
        if ssh_ready(): return True
        time.sleep(2)
    return False


# ---- tunnels --------------------------------------------------------------------------------------------------------
def ports_file():
    try: return json.loads((RUN / 'ports.json').read_text())
    except (FileNotFoundError, ValueError): return {'toVm': [], 'fromVm': []}


MAX_PORTS = 64


def forward(port, to_vm):
    """ssh's options for one port: the guest's localhost:port -> this machine's (to_vm), or the other way."""
    if to_vm: return ['-R', f'127.0.0.1:{port}:127.0.0.1:{port}', '-R', f'[::1]:{port}:127.0.0.1:{port}']   # "localhost" is ::1 first on Windows
    return ['-L', f'127.0.0.1:{port}:127.0.0.1:{port}']


def tunnel_command(ports):
    # A port that is taken on the other side is left out (ssh warns, tunnel_error reports it); the rest still cross.
    c = config(); args = [a for a in ssh_args('-N', '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3') if a != '-q']
    args[1:1] = ['-o', 'LogLevel=INFO', '-M', '-S', str(RUN / 'mux.sock')]   # the first value wins: ssh's warnings name the ports
    for port in sorted(set(ports['toVm']) | {c['clip_port']}): args[1:1] = forward(port, True)
    for port in sorted(set(ports['fromVm'])): args[1:1] = forward(port, False)
    return args


def mux(operation, *options):
    """Ask the running tunnel connection to check itself, or to add (forward) or drop (cancel) forwards."""
    return subprocess.run(['ssh', '-S', str(RUN / 'mux.sock'), '-O', operation, *options, 'winvm'], capture_output=True, text=True, timeout=15)


REFUSED = {True: 'remote port forwarding failed for listen port {}', False: 'cannot listen to port: {}'}   # ssh's own words


def change_ports(old, new):
    """Add and drop forwards on the running connection: the ports that stay keep their open connections. False: start it over."""
    try:
        if not pid_of('tunnel') or mux('check').returncode: return False
        added, said = set(), []
        for key, to_vm in (('toVm', True), ('fromVm', False)):
            for port in sorted(set(old[key]) - set(new[key])): mux('cancel', *forward(port, to_vm))
            for port in sorted(set(new[key]) - set(old[key])):
                added.add(str(port))
                if mux('forward', *forward(port, to_vm)).returncode: said.append(REFUSED[to_vm].format(port))
    except (OSError, subprocess.TimeoutExpired): return False
    kept = [l for l in (RUN / 'tunnel.err').read_text(errors='replace').splitlines() if not set(re.findall(r'\d+', l)) & added]
    (RUN / 'tunnel.err').write_text('\n'.join(kept + said) + '\n')         # what was said about a port before it was added again is over
    return True


def set_ports(to_vm, from_vm):
    """(Re)start the tunnel with exactly these ports. Returns an error message, or None when it is up."""
    c = config(); ports = {'toVm': sorted(set(to_vm)), 'fromVm': sorted(set(from_vm))}
    reserved = {c['ssh_port'], c['clip_port']}
    bad = [p for p in ports['toVm'] + ports['fromVm'] if not 1 <= p <= 65535 or p in reserved]
    if bad: return f'ports {bad} are not allowed ({sorted(reserved)} are winvm\'s own)'
    # Windows' SSH server has about 250 sockets per connection: two per port into the VM, one per open connection.
    if max(len(ports['toVm']), len(ports['fromVm'])) > MAX_PORTS: return f'at most {MAX_PORTS} ports can be connected per direction'
    old = ports_file(); (RUN / 'ports.json').write_text(json.dumps(ports))
    if tunnel_error() in (None, refused_ports(tunnel_said(), old)) and change_ports(old, ports): return tunnel_error()
    stop('tunnel', group=True)
    (RUN / 'tunnel.log').write_text('')
    spawn('tunnel', [sys.executable, str(Path(__file__).resolve()), '_tunnel'], 'tunnel.log')
    deadline = time.time() + 20                                   # the loop writes its first line once it knows
    while time.time() < deadline and pid_of('tunnel') and not (RUN / 'tunnel.log').read_text().strip(): time.sleep(0.3)
    return tunnel_error()


def tunnel_error():
    if pid_of('tunnel') is None: return 'the tunnel is not running'
    lines = [l for l in (RUN / 'tunnel.log').read_text(errors='replace').splitlines() if l.strip()]
    if not lines: return 'the ports are still being connected'
    if 'tunnel up' not in lines[-1]: return lines[-1]
    return refused_ports(tunnel_said(), ports_file())


def tunnel_said():
    try: return (RUN / 'tunnel.err').read_text(errors='replace')
    except FileNotFoundError: return ''


def refused_ports(ssh_output, wanted):
    """What ssh said about forwards it could not set up, as one sentence (None when all the wanted ports are up)."""
    ports = lambda pattern, key: sorted({int(p) for p in re.findall(pattern, ssh_output)} & set(wanted[key]))
    parts = [f'{where}: {", ".join(map(str, found))}' for where, found in
             (('already in use inside Windows', ports(r'remote port forwarding failed for listen port (\d+)', 'toVm')),
              ('already in use on this machine', ports(r'cannot listen to port: (\d+)', 'fromVm'))) if found]
    return 'not connected, ' + '; '.join(parts) + ' (the other ports are connected)' if parts else None


def tunnel_loop():
    """Keep one SSH connection carrying the forwards while the VM runs (`winvm _tunnel`, started by set_ports)."""
    child = None
    def leave(*_):
        if child and child.poll() is None: child.terminate()
        sys.exit(0)
    signal.signal(signal.SIGTERM, leave)
    while running():
        started = time.time()
        with open(RUN / 'tunnel.err', 'w') as err:
            child = subprocess.Popen(tunnel_command(ports_file()), stdin=subprocess.DEVNULL, stderr=err)
        time.sleep(2)
        if child.poll() is None: print('tunnel up', flush=True)
        child.wait()
        if not running(): break
        said = [l for l in (RUN / 'tunnel.err').read_text(errors='replace').splitlines() if l.strip() and 'forwarding' not in l and 'listen' not in l]
        print(said[-1] if said else 'the tunnel connection ended', flush=True)
        time.sleep(1 if time.time() - started > 30 else 5)


def check():
    """`winvm _check`: the parsing that has no VM to fail against."""
    said = ('Warning: remote port forwarding failed for listen port 3389\nWarning: remote port forwarding failed for listen port 3389\n'
            'bind [127.0.0.1]:9222: Address already in use\nchannel_setup_fwd_listener_tcpip: cannot listen to port: 9222\n')
    wanted = {'toVm': [3000, 3389], 'fromVm': [9222]}
    assert refused_ports(said, wanted) == ('not connected, already in use inside Windows: 3389; already in use on this machine: 9222 '
                                           '(the other ports are connected)'), refused_ports(said, wanted)
    assert refused_ports(said, {'toVm': [3000], 'fromVm': []}) is None          # a port no longer wanted is no longer a problem
    assert refused_ports('Warning: Permanently added [127.0.0.1]:2222 to the list of known hosts.', wanted) is None
    assert REFUSED[True].format(3389) in said and REFUSED[False].format(9222) in said
    print('ok')


# ---- commands -------------------------------------------------------------------------------------------------------
def status():
    state = 'stopped'
    if running(): state = 'running' if ssh_ready() else 'starting'
    ports = ports_file() if state != 'stopped' else {'toVm': [], 'fromVm': []}
    out = {'state': state, 'home': str(HOME), 'viewer': pid_of('viewer') is not None, **ports}
    if state == 'running':
        error = tunnel_error()
        if error: out['tunnelError'] = error
    return out


def cmd_status(a):
    s = status()
    if a.json: print(json.dumps(s))
    else:
        print(f"{s['state']}  ({s['home']})")
        if s['state'] != 'stopped':
            print(f"  into the VM: {s['toVm'] or 'no ports'}   from the VM: {s['fromVm'] or 'no ports'}   viewer: {'open' if s['viewer'] else 'closed'}")
            if s.get('tunnelError'): print(f"  tunnel: {s['tunnelError']}")


def cmd_up(a):
    if not running(): start_vm()
    if not wait_ssh(a.wait): die(f'Windows did not answer within {a.wait} s; it may still be starting (winvm status)', 4)
    error = set_ports(a.to_vm, a.from_vm)
    if a.view: open_viewer()
    if a.json: print(json.dumps(status()))
    if error: die(f'the VM is up, but its ports are not connected: {error}', 5)
    if not a.json: cmd_status(a)


def cmd_ports(a):
    need_running(); error = set_ports(a.to_vm, a.from_vm)
    if error: die(error, 5)
    cmd_status(a)


def cmd_down(a):
    stop('viewer'); stop('tunnel', group=True)
    if running():
        if ssh_ready(): powershell('shutdown /s /f /t 0', timeout=30)
        else:
            try: qmp('system_powerdown')
            except (OSError, RuntimeError): pass
        deadline = time.time() + a.wait       # Windows can take minutes; killing it mid-way costs a long recovery boot
        while running() and time.time() < deadline: time.sleep(1)
        if running():
            print(f'winvm: Windows did not shut down in {a.wait} s, powering off', file=sys.stderr); stop('qemu')
    for helper in ('qemu', 'passt', 'swtpm'): stop(helper)
    for leftover in RUN.glob('*.sock'): leftover.unlink(missing_ok=True)
    (RUN / 'ports.json').unlink(missing_ok=True)
    print('stopped')


def cmd_exec(a):
    need_running()
    try: p = powershell(' '.join(a.command), timeout=a.timeout, cwd=a.cwd, capture=False)
    except subprocess.TimeoutExpired: die(f'no result after {a.timeout} s (the command may still be running in the VM)', 124)
    sys.exit(p.returncode)


DIAGNOSTICS = r'''
