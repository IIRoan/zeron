+    // Emulated VSync. A display-only driver has no vertical blank of its own; when it reports none, dxgkrnl and
+    // DWM compose on the system clock and applications have nothing to synchronise their presents to, so frames
+    // are regularly composed a tick late or dropped. A high resolution timer stands in for the vertical blank
+    // whenever dxgkrnl asks for the VSync interrupt.
+    PEX_TIMER m_pVSyncTimer;
+    ULONG m_VSyncRate; // Hz, 0 = no VSync (registry VSyncRate)
+    volatile LONG m_VSyncEnabled;
+    LARGE_INTEGER m_LastVSync;
+    LONGLONG m_VSyncPeriodQpc; // one refresh, in performance counter ticks
+    LONGLONG m_NextVSyncQpc;   // when the next vertical blank is due on the ideal timeline
+    LONGLONG m_VSyncAnchorQpc; // origin of the timeline; it keeps running, unseen, while VSync is off
+    LONGLONG m_QpcFrequency;
+    BOOLEAN m_bTimerResolutionSet;
+    // The compositor starts a pass on every VSync interrupt and shows whatever applications presented before it.
+    // Applications without a hardware vertical blank to wait on pace themselves with timers of arbitrary phase, so
+    // at one interrupt per refresh a frame that lands just after a pass waits a whole refresh and the next one is
+    // dropped. Interrupting N times per reported refresh lets the compositor pick every frame up within 1/N of it.
+    ULONG m_VSyncOversample; // interrupts per reported refresh (registry VSyncOversample), 1 = plain VSync
