+NTSTATUS VioGpuDod::ControlInterrupt(_In_ CONST DXGK_INTERRUPT_TYPE InterruptType, _In_ BOOLEAN EnableInterrupt)
+{
+    PAGED_CODE();
+
+    if (InterruptType == DXGK_INTERRUPT_DISPLAYONLY_VSYNC && m_VSyncRate != 0)
+    {
+        EnableVSync(EnableInterrupt);
+        return STATUS_SUCCESS;
+    }
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+VOID VioGpuDod::EnableVSync(_In_ BOOLEAN bEnable)
+{
+    PAGED_CODE();
+
+    if (!bEnable)
+    {
+        InterlockedExchange(&m_VSyncEnabled, 0);
+        if (m_pVSyncTimer != NULL)
+        {
+            ExCancelTimer(m_pVSyncTimer, NULL);
+        }
+        if (m_bTimerResolutionSet)
+        {
+            ExSetTimerResolution(0, FALSE);
+            m_bTimerResolutionSet = FALSE;
+        }
+        return;
+    }
+    if (m_VSyncRate == 0)
+    {
+        return;
+    }
+    if (m_pVSyncTimer == NULL)
+    {
+        // high resolution: the default 15.6 ms clock tick cannot keep a 60 Hz period
+        m_pVSyncTimer = ExAllocateTimer(VioGpuVSyncTimerCallback, this, EX_TIMER_HIGH_RESOLUTION);
+        if (m_pVSyncTimer == NULL)
+        {
+            return;
+        }
+    }
+    // Each tick is a one-shot timer aimed at the next point of an ideal timeline (see VSyncTimerProc). A periodic
+    // timer restarts from the moment it actually fired, so its lateness accumulates and the rate sags below the
+    // refresh rate that applications were told about.
+    LARGE_INTEGER freq;
+    LARGE_INTEGER now = KeQueryPerformanceCounter(&freq);
+    m_QpcFrequency = freq.QuadPart;
+    m_VSyncPeriodQpc = freq.QuadPart / ((LONGLONG)m_VSyncRate * m_VSyncOversample);
+    if (m_VSyncAnchorQpc == 0)
+    {
+        m_VSyncAnchorQpc = now.QuadPart;
+    }
+    // dxgkrnl switches VSync off whenever nothing is composed. Resume on the same timeline instead of starting a
+    // new one, so the phase of the vertical blank never jumps.
+    m_NextVSyncQpc = m_VSyncAnchorQpc + ((now.QuadPart - m_VSyncAnchorQpc) / m_VSyncPeriodQpc + 1) * m_VSyncPeriodQpc;
+    if (!m_bTimerResolutionSet)
+    {
+        // keep the system clock fine while frames are being composed; it is given back when VSync is turned off
+        ExSetTimerResolution(10000, TRUE);
+        m_bTimerResolutionSet = TRUE;
+    }
+    InterlockedExchange(&m_VSyncEnabled, 1);
+    ExSetTimer(m_pVSyncTimer, -max((m_NextVSyncQpc - now.QuadPart) * 10000000LL / m_QpcFrequency, 1LL), 0, NULL);
+}
+
+NTSTATUS VioGpuDod::GetScanLine(_Inout_ DXGKARG_GETSCANLINE *pGetScanLine)
+{
+    PAGED_CODE();
+
+    if (m_VSyncRate == 0)
+    {
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    // There is no beam: derive a position from the time since the last emulated vertical blank.
+    LARGE_INTEGER freq;
+    LARGE_INTEGER now = KeQueryPerformanceCounter(&freq);
+    LONGLONG period = freq.QuadPart / m_VSyncRate;
+    UINT height = m_CurrentMode.DispInfo.Height ? m_CurrentMode.DispInfo.Height : 1;
+    UINT total = height + height / 20;
+    LONGLONG elapsed = period > 0 ? (now.QuadPart - m_LastVSync.QuadPart) % period : 0;
+    UINT line = period > 0 ? (UINT)(elapsed * total / period) : 0;
+    pGetScanLine->InVerticalBlank = line >= height;
+    pGetScanLine->ScanLine = pGetScanLine->InVerticalBlank ? 0 : line;
+    return STATUS_SUCCESS;
+}
