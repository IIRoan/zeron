+VOID VioGpuVSyncTimerCallback(_In_ PEX_TIMER Timer, _In_opt_ PVOID Context)
+{
+    UNREFERENCED_PARAMETER(Timer);
+    VioGpuDod *pVioGpuDod = reinterpret_cast<VioGpuDod *>(Context);
+    if (pVioGpuDod != NULL)
+    {
+        pVioGpuDod->VSyncTimerProc();
+    }
+}
+
+BOOLEAN VioGpuVSyncSynchRoutine(_In_ PVOID Context)
+{
+    reinterpret_cast<VioGpuDod *>(Context)->IndicateVSync();
+    return TRUE;
+}
+
+VOID VioGpuDod::VSyncTimerProc(VOID)
+{
+    if (m_VSyncEnabled && m_AdapterPowerState == PowerDeviceD0 && IsDriverActive())
+    {
+        BOOLEAN bRet = FALSE;
+        m_LastVSync = KeQueryPerformanceCounter(NULL);
+        // DxgkCbNotifyInterrupt has to run synchronised with the interrupt service routine
+        m_DxgkInterface.DxgkCbSynchronizeExecution(m_DxgkInterface.DeviceHandle,
+                                                   VioGpuVSyncSynchRoutine,
+                                                   this,
+                                                   0,
+                                                   &bRet);
+    }
+    if (m_VSyncEnabled && m_pVSyncTimer != NULL && m_VSyncPeriodQpc > 0 && m_QpcFrequency > 0)
+    {
+        LARGE_INTEGER now = KeQueryPerformanceCounter(NULL);
+        m_NextVSyncQpc += m_VSyncPeriodQpc;
+        if (m_NextVSyncQpc <= now.QuadPart)
+        {
+            // more than a refresh late: drop the missed ones rather than firing a burst
+            m_NextVSyncQpc += ((now.QuadPart - m_NextVSyncQpc) / m_VSyncPeriodQpc + 1) * m_VSyncPeriodQpc;
+        }
+        LONGLONG due = (m_NextVSyncQpc - now.QuadPart) * 10000000LL / m_QpcFrequency; // 100 ns units
+        ExSetTimer(m_pVSyncTimer, -max(due, 1LL), 0, NULL);
+    }
+}
+
+VOID VioGpuDod::IndicateVSync(VOID)
+{
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA NotifyInterrupt = {};
+    NotifyInterrupt.InterruptType = DXGK_INTERRUPT_DISPLAYONLY_VSYNC;
+    NotifyInterrupt.DisplayOnlyVsync.VidPnTargetId = 0;
+    m_DxgkInterface.DxgkCbNotifyInterrupt(m_DxgkInterface.DeviceHandle, &NotifyInterrupt);
+    m_DxgkInterface.DxgkCbQueueDpc(m_DxgkInterface.DeviceHandle);
+}
