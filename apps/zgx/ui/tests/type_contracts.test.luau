test("busy buttons keep native actions and callbacks, and block repeated activation", function()
	local app = mount("type_contracts_fixture.luau")
	app:resize(600, 500)
	app:frames(10)
	for _, label in { "Native action", "Callback" } do
		app:click(`role:button "{label}"`)
	end
	app:frames(10)
	expect(app:state("type_test_actions")).to_be(1)
	expect(app:state("type_test_callbacks")).to_be(1)
	for _, state in { "type_test_busy", "type_test_disabled" } do
		app:set_state(state, true)
		app:frames(10)
		for _, label in { "Native action", "Callback" } do
			pcall(function() app:click(`role:button "{label}"`) end)
		end
		app:frames(10)
		expect(app:state("type_test_actions")).to_be(1)
		expect(app:state("type_test_callbacks")).to_be(1)
		app:set_state(state, false)
		app:frames(10)
	end
	app:click('role:button "Native action"')
	app:click('role:button "Callback"')
	app:frames(10)
	expect(app:state("type_test_actions")).to_be(2)
	expect(app:state("type_test_callbacks")).to_be(2)
	expect(app:error()).to_be_nil()
end)

test("busy buttons preserve custom disabled styles while guarding callbacks", function()
	local app = mount("type_contracts_fixture.luau")
	app:resize(600, 500)
	app:frames(10)
	app:click('role:button "Styled callback"')
	app:frames(10)
	expect(app:state("type_test_styled")).to_be(1)
	app:set_state("type_test_busy", true)
	app:frames(10)
	app:click('role:button "Styled callback"')
	app:frames(10)
	expect(app:state("type_test_styled")).to_be(1)
	expect(app:error()).to_be_nil()
end)

test("localized menu headings, typeahead and confirmation read message text", function()
	local app = mount("type_contracts_fixture.luau")
	app:resize(600, 500)
	app:frames(10)
	app:right_click('role:button "Menu"')
	app:frames(30)
	app:key("c")
	app:frames(10)
	app:key("Enter")
	app:frames(30)
	app:wait("#never-shown", { timeout_ms = 350 })
	app:key("Enter")
	app:wait("#never-shown", { timeout_ms = 350 })
	app:frames(10)
	expect(app:state("type_test_selected")).to_be(1)
	expect(app:error()).to_be_nil()
end)
